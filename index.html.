<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Biblioteca Mundo de Ideas</title><meta name="description" content="Catálogo digital de la Biblioteca Mundo de Ideas: busca libros, aparta y entérate de los talleres."><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect x='6' y='8' width='6' height='18' fill='%231D3FA8'/%3E%3Crect x='14' y='4' width='6' height='22' fill='%23F4C430'/%3E%3Crect x='22' y='11' width='6' height='15' fill='%23C73A26'/%3E%3C/svg%3E"><style>
/* Layout: sticky header, hero with search and a shelf of book spines, then catalog, new arrivals, rankings, events, and reader/librarian panels. */
:root{
  --bg:#F2F4F9; --surface:#FFFFFF; --ink:#101935; --muted:#4D5877; --line:#D5DAE8; --soft:#E7ECF8;
  --blue:#1D3FA8; --on-blue:#FFFFFF; --yellow:#F4C430; --on-yellow:#101935;
  --red:#C73A26; --green:#1B7048; --on-green:#FFFFFF; --star:#D69A00; --shelf:#101935;
  --foot-bg:#101935; --foot-fg:#E9EDF8; --foot-muted:#C5CCE4;
  --serif:"Iowan Old Style","Palatino Linotype",Palatino,"Book Antiqua",Georgia,serif;
  --sans:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    color-scheme:dark;
    --bg:#0C1226; --surface:#151C36; --ink:#EEF1FA; --muted:#A8B1CE; --line:#2A3358; --soft:#1C2545;
    --blue:#7D97FF; --on-blue:#0C1226; --yellow:#F4C430; --on-yellow:#101935;
    --red:#FF8A74; --green:#5BD398; --on-green:#0C1226; --star:#F4C430; --shelf:#2A3358;
    --foot-bg:#070B18; --foot-fg:#E9EDF8; --foot-muted:#B4BCD8;
  }
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --bg:#0C1226; --surface:#151C36; --ink:#EEF1FA; --muted:#A8B1CE; --line:#2A3358; --soft:#1C2545;
  --blue:#7D97FF; --on-blue:#0C1226; --yellow:#F4C430; --on-yellow:#101935;
  --red:#FF8A74; --green:#5BD398; --on-green:#0C1226; --star:#F4C430; --shelf:#2A3358;
  --foot-bg:#070B18; --foot-fg:#E9EDF8; --foot-muted:#B4BCD8;
}
*{box-sizing:border-box}
html{scroll-padding-top:84px}
@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.55}
h1,h2,h3{font-family:var(--serif);line-height:1.15;margin:0;font-weight:700;text-wrap:balance}
a{color:inherit}
button{font:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--blue);outline-offset:2px;border-radius:4px}
.wrap{max-width:1120px;margin:0 auto;padding-left:max(20px,env(safe-area-inset-left,0px));padding-right:max(20px,env(safe-area-inset-right,0px))}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

/* Header */
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--surface)}
header.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--surface);border-bottom:1px solid var(--line)}
.top .wrap{display:flex;align-items:center;gap:20px;min-height:64px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;font-family:var(--serif);font-weight:700;font-size:1.15rem;white-space:nowrap}
.brand i{display:flex;align-items:flex-end;gap:2px;height:26px}
.brand i b{display:block;width:7px;border-radius:1px}
.brand i b:nth-child(1){height:20px;background:var(--blue)}
.brand i b:nth-child(2){height:26px;background:var(--yellow)}
.brand i b:nth-child(3){height:16px;background:var(--red)}
nav.main{display:flex;gap:4px;flex:1;overflow-x:auto;scrollbar-width:none}
nav.main a{padding:8px 12px;border-radius:8px;text-decoration:none;color:var(--muted);font-weight:600;font-size:.95rem;white-space:nowrap}
nav.main a:hover{background:var(--soft);color:var(--ink)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;border:1.5px solid var(--blue);background:var(--blue);color:var(--on-blue);padding:9px 16px;border-radius:8px;font-weight:700;font-size:.95rem;text-decoration:none}
.btn:hover{filter:brightness(1.08)}
.btn.ghost{background:transparent;color:var(--ink);border-color:var(--line)}
.btn.ghost:hover{border-color:var(--ink)}
.btn.small{padding:6px 12px;font-size:.88rem}
.btn.danger{background:transparent;border-color:var(--red);color:var(--red)}
.btn[disabled]{opacity:.5;cursor:not-allowed}
.who{display:flex;align-items:center;gap:10px;white-space:nowrap}
.who span{font-size:.9rem;color:var(--muted)}

/* Hero */
.hero{padding:56px 0 0;background:var(--surface);border-bottom:1px solid var(--line)}
.hero h1{font-size:clamp(2.1rem,5.2vw,3.6rem);max-width:15em;letter-spacing:-.01em}
.hero p.lead{max-width:38em;color:var(--muted);font-size:1.1rem;margin:16px 0 26px}
.searchbar{display:flex;gap:8px;max-width:640px}
.searchbar input{flex:1;min-width:0}
input,select,textarea{font:inherit;color:var(--ink);background:var(--bg);border:1.5px solid var(--line);border-radius:8px;padding:10px 12px;width:100%}
input::placeholder,textarea::placeholder{color:var(--muted)}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.chip{border:1.5px solid var(--line);background:transparent;color:var(--ink);padding:5px 12px;border-radius:99px;font-size:.88rem;font-weight:600}
.chip:hover{border-color:var(--blue)}
.shelf{margin-top:44px;display:flex;align-items:flex-end;gap:5px;overflow-x:auto;padding-left:max(20px,env(safe-area-inset-left,0px));padding-right:max(20px,env(safe-area-inset-right,0px));scrollbar-width:none;border-bottom:12px solid var(--shelf)}
.shelf-wrap{max-width:1120px;margin:0 auto}
.spine{flex:none;border:0;border-radius:3px 3px 0 0;writing-mode:vertical-rl;padding:14px 0;display:flex;align-items:center;justify-content:flex-start;font-family:var(--serif);font-weight:700;font-size:.95rem;box-shadow:inset 3px 0 0 rgba(255,255,255,.22),inset -3px 0 0 rgba(0,0,0,.16);transform-origin:bottom;transition:transform .2s}
.spine:hover,.spine:focus-visible{transform:translateY(-14px)}
.spine span{max-height:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block}
@media (prefers-reduced-motion:no-preference){
  .spine{animation:rise .6s cubic-bezier(.2,.8,.2,1) backwards;animation-delay:calc(var(--i)*55ms)}
  @keyframes rise{from{transform:translateY(120%)}}
}

/* Sections */
section.block{padding:64px 0 8px}
.head{display:flex;align-items:end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:22px}
.head h1,.head h2{font-size:clamp(1.6rem,3.2vw,2.2rem)}
.head p{margin:6px 0 0;color:var(--muted);max-width:34em}
.filters{display:grid;grid-template-columns:1fr 200px auto;gap:10px;align-items:center;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:14px;margin-bottom:6px}
.filters label.chk{display:flex;gap:8px;align-items:center;font-weight:600;font-size:.92rem;white-space:nowrap}
.filters label.chk input{width:auto}
.count{color:var(--muted);font-size:.92rem;margin:10px 2px}
.list{background:var(--surface);border:1px solid var(--line);border-radius:12px;overflow:hidden}
.row{display:grid;grid-template-columns:58px 1fr auto;gap:16px;align-items:center;padding:14px 16px;border-top:1px solid var(--line)}
.row:first-child{border-top:0}
.cover{width:58px;height:80px;border-radius:3px 6px 6px 3px;display:flex;align-items:center;justify-content:center;padding:6px;text-align:center;font-family:var(--serif);font-weight:700;font-size:.68rem;line-height:1.1;box-shadow:inset 4px 0 0 rgba(255,255,255,.22),inset -2px 0 0 rgba(0,0,0,.15);overflow:hidden}
.row h3{font-size:1.1rem}
.row h3 button{all:unset;cursor:pointer}
.row h3 button:hover{text-decoration:underline}
.meta{color:var(--muted);font-size:.9rem;margin-top:2px}
.meta button{all:unset;cursor:pointer;text-decoration:underline;text-decoration-color:var(--line);text-underline-offset:3px}
.meta button:hover{color:var(--ink)}
.tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;align-items:center}
.tag{font-size:.78rem;font-weight:700;padding:2px 9px;border-radius:99px;background:var(--soft);color:var(--ink)}
.tag.sv{background:var(--yellow);color:var(--on-yellow)}
.ok{color:var(--green);font-weight:700;font-size:.86rem}
.no{color:var(--red);font-weight:700;font-size:.86rem}
.acts{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
.empty{padding:36px 20px;text-align:center;color:var(--muted)}
.stars{color:var(--star);letter-spacing:1px;font-size:.9rem}

.two{display:grid;grid-template-columns:3fr 2fr;gap:28px}
.rank{list-style:none;margin:0;padding:0;background:var(--surface);border:1px solid var(--line);border-radius:12px}
.rank li{display:grid;grid-template-columns:34px 1fr auto;gap:10px;align-items:center;padding:11px 16px;border-top:1px solid var(--line)}
.rank li:first-child{border-top:0}
.rank .n{font-family:var(--serif);font-weight:700;font-size:1.25rem;color:var(--blue)}
.rank button{all:unset;cursor:pointer;font-weight:600}
.rank button:hover{text-decoration:underline}
.rank small{color:var(--muted)}
h3.sub{font-size:1.25rem;margin-bottom:12px}

/* Events */
.event{display:grid;grid-template-columns:76px 1fr auto;gap:18px;align-items:center;padding:16px;border-top:1px solid var(--line)}
.event:first-child{border-top:0}
.date{background:var(--blue);color:var(--on-blue);border-radius:10px;text-align:center;padding:8px 4px;font-family:var(--serif)}
.date b{display:block;font-size:1.7rem;line-height:1}
.date span{font-size:.8rem;font-family:var(--sans);font-weight:600}
.event.past{opacity:.6}
.event h3{font-size:1.15rem}
.event p{margin:4px 0 0;color:var(--muted);font-size:.93rem}
.state{font-size:.8rem;font-weight:700;margin-left:8px;padding:2px 9px;border-radius:99px;background:var(--soft);vertical-align:middle;font-family:var(--sans)}
.state.live{background:var(--green);color:var(--on-green)}

/* Account & admin */
.panel{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:20px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.loan{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;padding:12px 0;border-top:1px solid var(--line)}
.loan:first-of-type{border-top:0}
.note{font-size:.9rem;color:var(--muted)}
table{width:100%;border-collapse:collapse;font-size:.92rem}
th,td{text-align:left;padding:9px 8px;border-top:1px solid var(--line);vertical-align:middle}
th{font-size:.82rem;color:var(--muted);border-top:0}
.tbl{overflow-x:auto}
.stock{display:inline-flex;align-items:center;gap:6px}
.stock button{width:26px;height:26px;border-radius:6px;border:1.5px solid var(--line);background:transparent;color:var(--ink);font-weight:700;line-height:1}
.fgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.fgrid .full{grid-column:1/-1}
label.f{display:block;font-weight:600;font-size:.88rem;margin-bottom:4px}
.log{margin:10px 0 0;padding:0;list-style:none;font-size:.88rem;color:var(--muted)}

/* Dialog */
dialog{border:1px solid var(--line);border-radius:14px;background:var(--surface);color:var(--ink);padding:0;width:min(600px,calc(100% - 28px));max-height:calc(100% - 40px)}
dialog::backdrop{background:rgba(8,12,30,.6)}
.dlg{padding:24px}
.dlg .close{float:right;border:0;background:transparent;color:var(--muted);font-size:1.6rem;line-height:1;padding:0 4px}
.tabs{display:flex;gap:6px;margin:8px 0 16px}
.tabs button{flex:1;padding:9px;border:1.5px solid var(--line);background:transparent;color:var(--ink);border-radius:8px;font-weight:700}
.tabs button[aria-selected="true"]{background:var(--blue);border-color:var(--blue);color:var(--on-blue)}
.review{border-top:1px solid var(--line);padding:10px 0}
.review p{margin:2px 0 0}
.err{color:var(--red);font-weight:600;font-size:.9rem;min-height:1.3em;margin:8px 0 0}
.toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translateX(-50%) translateY(20px);background:var(--ink);color:var(--bg);padding:11px 18px;border-radius:10px;font-weight:600;opacity:0;pointer-events:none;transition:.25s;z-index:60;max-width:calc(100% - 32px);text-align:center}
.toast.show{opacity:1;transform:translateX(-50%)}

footer{margin-top:72px;background:var(--foot-bg);color:var(--foot-fg);padding-block:40px;border-top:1px solid var(--line)}
footer h2{font-size:1.2rem;color:var(--yellow)}
footer p{margin:6px 0;font-size:.92rem;color:var(--foot-muted)}
footer ul{columns:2;margin:10px 0 0;padding-left:18px;font-size:.9rem;color:var(--foot-muted)}
.hide{display:none!important}

@media (max-width:820px){
  html{scroll-padding-top:124px}
  .fgrid{grid-template-columns:1fr}
  .two,.grid2{grid-template-columns:1fr}
  .filters{grid-template-columns:1fr}
  .top .wrap{flex-wrap:wrap;padding-top:8px;padding-bottom:8px;gap:8px}
  nav.main{order:3;flex-basis:100%}
  .row{grid-template-columns:50px 1fr;}
  .row .acts{grid-column:1/-1;justify-content:flex-start}
  .cover{width:50px;height:70px}
  .event{grid-template-columns:62px 1fr}
  .event .acts{grid-column:1/-1;justify-content:flex-start}
  .who span{display:none}
  footer ul{columns:1}
}
.filters>*,.row>div,.event>div,.loan>div,.grid2>*,.two>*{min-width:0}
@media (prefers-reduced-motion:reduce){.spine,.toast{transition:none}.spine:hover,.spine:focus-visible{transform:none}}
nav.main a[aria-current="page"]{background:var(--soft);color:var(--ink)}

:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
.view{display:none}.view.on{display:block}
</style></head><body>
<header class="top">
  <div class="wrap">
    <a class="brand" href="#p-inicio" aria-label="Biblioteca Mundo de Ideas, inicio"><i aria-hidden="true"><b></b><b></b><b></b></i>Mundo de Ideas</a>
    <nav class="main" aria-label="Principal"><a href="#p-inicio">Inicio</a><a href="#p-catalogo">Catálogo</a><a href="#p-nuevos">Nuevos ingresos</a><a href="#p-populares">Lo más visto</a><a href="#p-eventos">Talleres y eventos</a><a href="#p-mis-reservas" id="navCuenta" class="hide">Mis reservas</a><a href="#p-panel" id="navAdmin" class="hide">Panel del bibliotecario</a></nav>
    <div class="who" id="who"></div>
  </div>
</header>

<main>
<div class="view" data-k="inicio">
  <div class="hero">
    <div class="wrap">
      <h1>¿Está disponible? Míralo antes de salir de casa.</h1>
      <p class="lead">Busca en el catálogo de la biblioteca, aparta tu libro desde el teléfono o la computadora y entérate de los talleres que vienen.</p>
      <div class="searchbar" role="search">
        <label class="sr" for="heroQ">Buscar por título, autor, género o ISBN</label>
        <input id="heroQ" type="search" placeholder="Título, autor, género o ISBN">
        <button class="btn" id="heroGo">Buscar libro</button>
      </div>
      <div class="chips" id="genreChips" aria-label="Géneros"></div>
    </div>
    <div class="shelf-wrap"><div class="shelf" id="shelf" aria-label="Libros populares de la biblioteca"></div></div>
  </div>
  <section class="block"><div class="wrap">
    <div class="head"><div><h2>Explora la biblioteca</h2></div></div>
    <div class="grid2">
      <div class="panel"><h3 class="sub">Catálogo</h3><p class="note" style="margin-top:0">Busca por título, autor, género o ISBN y aparta tu libro.</p><a class="btn small" href="#p-catalogo">Ver catálogo</a></div>
      <div class="panel"><h3 class="sub">Nuevos ingresos</h3><p class="note" style="margin-top:0">Los libros que llegaron a la biblioteca en los últimos días.</p><a class="btn small" href="#p-nuevos">Ver novedades</a></div>
      <div class="panel"><h3 class="sub">Lo más visto</h3><p class="note" style="margin-top:0">Los libros y escritores que más consultan los lectores.</p><a class="btn small" href="#p-populares">Ver ranking</a></div>
      <div class="panel"><h3 class="sub">Talleres y eventos</h3><p class="note" style="margin-top:0">Fechas, horarios y lugares. Inscríbete con tu cuenta.</p><a class="btn small" href="#p-eventos">Ver actividades</a></div>
    </div>
  </div></section>
</div>
<div class="view" data-k="catalogo">
  <section class="block" id="catalogo">
    <div class="wrap">
      <div class="head">
        <div><h1>Catálogo</h1><p>Busca por título, autor, género o ISBN. Para apartar un libro necesitas iniciar sesión.</p></div>
      </div>
      <div class="filters">
        <div><label class="sr" for="q">Buscar</label><input id="q" type="search" placeholder="Ej. García Márquez, poesía, 978…"></div>
        <div><label class="sr" for="genre">Género</label><select id="genre"></select></div>
        <label class="chk"><input type="checkbox" id="onlyAvail"> Solo disponibles</label>
      </div>
      <div class="count" id="count" aria-live="polite"></div>
      <div class="list" id="results"></div>
    </div>
  </section>
</div>
<div class="view" data-k="nuevos">
  <section class="block" id="novedades">
    <div class="wrap">
      <div class="head"><div><h1>Nuevos ingresos</h1><p>Libros que llegaron a la biblioteca en los últimos días.</p></div></div>
      <div class="list" id="newList"></div>
    </div>
  </section>
</div>
<div class="view" data-k="populares">
  <section class="block" id="populares">
    <h1 class="sr">Lo más visto y escritores más leídos</h1>
    <div class="wrap two">
      <div id="escritoresTop"></div>
      <div id="escritores">
        <h2 style="font-size:clamp(1.6rem,3.2vw,2.2rem);margin-bottom:6px">Escritores más leídos</h2>
        <p class="note" style="margin:0 0 16px">Los diez autores cuyos libros más se consultan en el catálogo.</p>
        <ol class="rank" id="authorRank"></ol>
      </div>
    </div>
  </section>
</div>
<div class="view" data-k="eventos">
  <section class="block" id="eventos">
    <div class="wrap">
      <div class="head"><div><h1>Talleres y eventos culturales</h1><p>Fechas de inicio y finalización, horario y lugar. Inscríbete con tu cuenta.</p></div></div>
      <div class="list" id="events"></div>
    </div>
  </section>
</div>
<div class="view" data-k="mis-reservas">
  <section class="block" id="cuenta">
    <div class="wrap">
      <div class="head"><div><h1>Mis reservas</h1><p>Puedes tener hasta 3 reservas al mismo tiempo.</p></div></div>
      <div id="cuentaGate" class="panel hide"></div>
      <div class="grid2" id="cuentaBody">
        <div class="panel" id="myLoans"></div>
        <div class="panel" id="myEvents"></div>
      </div>
    </div>
  </section>
</div>
<div class="view" data-k="panel">
  <section class="block" id="admin">
    <div class="wrap">
      <div class="head"><div><h1>Panel del bibliotecario</h1><p>Registra libros, ajusta el stock y anota salidas y devoluciones.</p></div></div>
      <div id="panelGate" class="panel hide"></div>
      <div id="panelBody">
      <div class="grid2">
        <div class="panel">
          <h3 class="sub">Registrar libro</h3>
          <form id="addForm" class="fgrid">
            <div class="full"><label class="f" for="aT">Título</label><input id="aT" required></div>
            <div><label class="f" for="aA">Autor</label><input id="aA" required></div>
            <div><label class="f" for="aE">Editorial</label><input id="aE"></div>
            <div><label class="f" for="aY">Año</label><input id="aY" type="number" min="1000" max="2100" required></div>
            <div><label class="f" for="aS">Ejemplares en stock</label><input id="aS" type="number" min="0" value="1" required></div>
            <div><label class="f" for="aG">Género</label><input id="aG" list="gList" required></div>
            <div><label class="f" for="aI">ISBN</label><input id="aI" placeholder="978-…"></div>
            <div class="full"><button class="btn" type="submit">Registrar libro</button></div>
          </form>
          <datalist id="gList"></datalist>
        </div>
        <div class="panel">
          <h3 class="sub">Salida y devolución</h3>
          <p class="note" style="margin-top:0">Escribe el código del ejemplar o su ISBN (con un lector de código de barras se llena solo).</p>
          <label class="f" for="scan">Código del ejemplar</label>
          <input id="scan" placeholder="MI-0001">
          <div class="acts" style="justify-content:flex-start;margin-top:10px">
            <button class="btn" id="btnOut">Registrar salida</button>
            <button class="btn ghost" id="btnIn">Registrar devolución</button>
          </div>
          <ul class="log" id="log"></ul>
        </div>
