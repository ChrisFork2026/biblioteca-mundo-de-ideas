 {t:'Crónica de una muerte anunciada',a:'Gabriel García Márquez',g:'Novela',y:1981,stock:0,waiting:2,views:66,d:'Reconstrucción del asesinato de Santiago Nasar, que todo el pueblo sabía que iba a ocurrir.',rv:[]},
 {t:'Veinte mil leguas de viaje submarino',a:'Julio Verne',g:'Aventura',y:1870,stock:3,views:47,d:'El profesor Aronnax y el capitán Nemo recorren los océanos a bordo del Nautilus.',rv:[R('Mateo H.',4,'Aventura con mucha ciencia para su época.')]},
 {t:'Como agua para chocolate',a:'Laura Esquivel',g:'Novela',y:1989,stock:2,views:52,ingreso:-3,d:'Tita expresa sus emociones a través de la cocina, en el México de la Revolución.',rv:[]},
 {t:'Insensatez',a:'Horacio Castellanos Moya',g:'Novela',y:2004,stock:2,views:35,sv:true,ingreso:-4,d:'Un corrector de textos revisa un informe sobre atrocidades cometidas contra población indígena y empieza a perder el equilibrio.',rv:[]},
 {t:'Pobrecito poeta que era yo',a:'Roque Dalton',g:'Novela',y:1976,stock:1,views:44,sv:true,d:'Novela del poeta salvadoreño que mezcla memorias, ficción y sátira.',rv:[]},
 {t:'Cenizas de Izalco',a:'Claribel Alegría y Darwin Flakoll',g:'Novela',y:1966,stock:2,views:31,sv:true,ingreso:-6,d:'Una mujer vuelve a El Salvador y reconstruye, entre cartas y recuerdos, la historia de su familia y la matanza de 1932.',rv:[]},
 {t:'El señor presidente',a:'Miguel Ángel Asturias',g:'Novela',y:1946,stock:2,views:38,ingreso:-9,d:'Retrato del miedo y la corrupción bajo una dictadura latinoamericana.',rv:[]},
 {t:'La tregua',a:'Mario Benedetti',g:'Novela',y:1960,stock:2,views:29,d:'El diario de un oficinista viudo que se acerca a la jubilación y se enamora de una compañera de trabajo.',rv:[]},
 {t:'Desolación',a:'Gabriela Mistral',g:'Poesía',y:1922,stock:2,views:26,ingreso:-10,d:'El primer libro de poemas de Gabriela Mistral, sobre el dolor, la pérdida y la fe.',rv:[]}
].map((b,i)=>({id:i+1,isbn:'978-99900-'+String(i+1).padStart(3,'0')+'-0',waiting:0,publisher:'',...b,
  ingreso: b.ingreso!==undefined ? daysFrom(b.ingreso) : null}));

const events = [
 {id:1,t:'Taller de escritura creativa',d:'Ejercicios semanales para empezar a escribir cuentos y poemas. No necesitas experiencia.',s:'2026-10-24',e:'2026-11-14',time:'Sábados, 9:00 a 11:00 a. m.',place:'Sala de talleres'},
 {id:2,t:'Círculo de lectura juvenil',d:'Para adolescentes: leemos un libro y lo comentamos entre todos.',s:'2026-10-21',e:'2026-11-18',time:'Miércoles, 3:00 a 4:30 p. m.',place:'Sala de lectura'},
 {id:3,t:'Hora del cuento infantil',d:'Cuentos en voz alta y juegos con palabras para niñas y niños.',s:'2026-10-31',e:'2026-10-31',time:'Sábado, 10:00 a. m.',place:'Rincón infantil'},
 {id:4,t:'Taller de búsqueda de información en línea',d:'Aprende a investigar en internet y a usar las computadoras de la biblioteca.',s:'2026-10-26',e:'2026-10-30',time:'Lunes a viernes, 2:00 a 3:00 p. m.',place:'Sala de cómputo'},
 {id:5,t:'Encuentro con escritores locales',d:'Autores de la zona presentan sus obras y conversan con el público.',s:'2026-11-05',e:'2026-11-05',time:'Jueves, 5:00 p. m.',place:'Salón principal'}
];
const parseD = s => new Date(s+'T00:00:00');

let users = [
 {email:'lector@demo.sv',name:'Lectora de prueba',pass:'lector123',role:'lector',loans:[],events:[]},
 {email:'admin@demo.sv',name:'Bibliotecaria de prueba',pass:'admin123',role:'admin',loans:[],events:[]}
];
let me = null, movements = [];

/* ---------- Estado compartido entre páginas (localStorage) ---------- */
const KEY='mundo-de-ideas-v1';
function save(){ try{ localStorage.setItem(KEY,JSON.stringify({books,users,movements,me:me?me.email:null})); }catch(e){} }
(function load(){ try{
  const s=JSON.parse(localStorage.getItem(KEY)); if(!s) return;
  books=s.books.map(b=>({...b,ingreso:b.ingreso?new Date(b.ingreso):null}));
  users=s.users.map(u=>({...u,loans:u.loans.map(l=>({...l,due:new Date(l.due)}))}));
  movements=s.movements||[]; me=s.me?(users.find(u=>u.email===s.me)||null):null;
}catch(e){} })();
addEventListener('pagehide',save);

/* ---------- Helpers de dominio ---------- */
const colorOf = b => palette[(b.id-1) % palette.length];
const avg = b => b.rv.length ? b.rv.reduce((s,r)=>s+r.stars,0)/b.rv.length : 0;
const starStr = n => '★'.repeat(Math.round(n)) + '☆'.repeat(5-Math.round(n));
const avail = b => b.stock>0 ? `<span class="ok">Disponible · ${b.stock} ${b.stock===1?'ejemplar':'ejemplares'}</span>` : `<span class="no">Agotado${b.waiting?` · ${b.waiting} en espera`:''}</span>`;
const byId = id => books.find(b=>b.id===id);
const genres = () => [...new Set(books.map(b=>b.g))].sort((a,b)=>a.localeCompare(b,'es'));
const bookByCode = c => { const k = norm(c).replace(/[^a-z0-9]/g,''); return books.find(b => norm(code(b)).replace(/[^a-z0-9]/g,'')===k || b.isbn.replace(/\D/g,'')===k.replace(/\D/g,'') && k.replace(/\D/g,'').length>=9); };

function toast(msg){ save();
  const t=$('#toast'); t.textContent=msg; t.classList.add('show');
  clearTimeout(toast.t); toast.t=setTimeout(()=>t.classList.remove('show'),3200);
}

/* ---------- Render: componentes ---------- */
function bookRow(b, opts={}){
  const c = colorOf(b);
  const rating = b.rv.length ? `<span class="stars" title="${avg(b).toFixed(1)} de 5">${starStr(avg(b))}</span> <span class="note">(${b.rv.length})</span>` : '';
  const isNew = b.ingreso && (today()-b.ingreso)/DAY <= 30;
  return `<div class="row">
    <div class="cover" style="background:${c.bg};color:${c.fg}" aria-hidden="true">${esc(b.t)}</div>
    <div>
      <h3><button data-open="${b.id}">${esc(b.t)}</button></h3>
      <div class="meta"><button data-author="${esc(b.a)}">${esc(b.a)}</button> · ${b.y}</div>
      <div class="tags"><span class="tag">${esc(b.g)}</span>${b.sv?'<span class="tag sv">Autor salvadoreño</span>':''}${isNew&&!opts.hideNew?'<span class="tag">Nuevo</span>':''}${avail(b)} ${rating}</div>
      ${opts.showIngreso && b.ingreso ? `<div class="note" style="margin-top:4px">Ingresó el ${fmt(b.ingreso)}</div>`:''}
    </div>
    <div class="acts">
      <button class="btn ghost small" data-open="${b.id}">Ver detalle</button>
      <button class="btn small" data-reserve="${b.id}" ${b.stock<1?'disabled':''}>Reservar</button>
    </div>
  </div>`;
}

function renderChips(){
  const G=genres(), sel=$('#genre'), keep=sel.value;
  $('#genreChips').innerHTML = G.map(g=>`<button class="chip" data-genre="${esc(g)}">${esc(g)}</button>`).join('');
  sel.innerHTML = '<option value="">Todos los géneros</option>' + G.map(g=>`<option>${esc(g)}</option>`).join('');
  sel.value = keep;
  $('#gList').innerHTML = G.map(g=>`<option value="${esc(g)}">`).join('');
}

function renderShelf(){
  const hs=[190,222,172,206,236,182,216,196,226,176,210,186,230,200];
  const ws=[46,54,42,58,50,44,56,48,52,60,44,54,48,56];
  const top=[...books].sort((a,b)=>b.views-a.views).slice(0,14);
  $('#shelf').innerHTML = top.map((b,i)=>{
    const c=colorOf(b);
    return `<button class="spine" style="--i:${i};height:${hs[i]}px;width:${ws[i]}px;background:${c.bg};color:${c.fg}" data-open="${b.id}" aria-label="${esc(b.t)}, de ${esc(b.a)}"><span>${esc(b.t)}</span></button>`;
  }).join('');
}

function renderCatalog(){
  const q = norm($('#q').value.trim()), g = $('#genre').value, only = $('#onlyAvail').checked;
  const qd = q.replace(/\D/g,'');
  const list = books.filter(b=>{
    if(g && b.g!==g) return false;
    if(only && b.stock<1) return false;
    if(!q) return true;
    return norm(b.t).includes(q) || norm(b.a).includes(q) || norm(b.g).includes(q) ||
           b.isbn.includes(q) || (qd.length>=4 && b.isbn.replace(/\D/g,'').includes(qd)) || norm(code(b)).includes(q);
  }).sort((a,b)=>a.t.localeCompare(b.t,'es'));
  $('#count').textContent = `${list.length} ${list.length===1?'título':'títulos'}`;
  $('#results').innerHTML = list.length ? list.map(b=>bookRow(b)).join('') :
    '<div class="empty">No encontramos ese título. Prueba con el autor, el género o parte del ISBN.</div>';
}

function renderNew(){
  const list = books.filter(b=>b.ingreso).sort((a,b)=>b.ingreso-a.ingreso);
  $('#newList').innerHTML = list.length ? list.map(b=>bookRow(b,{showIngreso:true,hideNew:true})).join('') :
    '<div class="empty">Todavía no hay nuevos ingresos registrados.</div>';
}

function renderTop(){
  const top = [...books].sort((a,b)=>b.views-a.views).slice(0,5);
  $('#escritoresTop').innerHTML = `<h2 style="font-size:clamp(1.6rem,3.2vw,2.2rem);margin-bottom:6px">Lo más visto de la semana</h2>
    <p class="note" style="margin:0 0 16px">Los libros que más consultaron los lectores.</p>
    <div class="list">${top.map(b=>bookRow(b)).join('')}</div>`;
  const map = {};
  books.forEach(b=>{ (map[b.a] ||= {a:b.a,v:0,n:0}); map[b.a].v+=b.views; map[b.a].n++; });
  const rank = Object.values(map).sort((x,y)=>y.v-x.v).slice(0,10);
  $('#authorRank').innerHTML = rank.map((r,i)=>`<li><span class="n">${i+1}</span><button data-author="${esc(r.a)}">${esc(r.a)}</button><small>${r.n} ${r.n===1?'título':'títulos'}</small></li>`).join('');
}

function eventState(ev){
  const t=today(), s=parseD(ev.s), e=parseD(ev.e);
  if(e<t) return {k:'past',l:'Finalizado'};
  if(s<=t) return {k:'live',l:'En curso'};
  const n=Math.round((s-t)/DAY);
  return {k:'soon',l: n===1?'Mañana':`Empieza en ${n} días`};
}
function renderEvents(){
  const list=[...events].sort((a,b)=>parseD(a.s)-parseD(b.s));
  $('#events').innerHTML = list.map(ev=>{
    const st=eventState(ev), s=parseD(ev.s), e=parseD(ev.e), same=ev.s===ev.e;
    const joined = me && me.events.includes(ev.id);
    return `<div class="event ${st.k==='past'?'past':''}">
      <div class="date" aria-hidden="true"><b>${s.getDate()}</b><span>${fmtShort(s)}</span></div>
      <div>
        <h3>${esc(ev.t)}<span class="state ${st.k==='live'?'live':''}">${st.l}</span></h3>
        <p>${esc(ev.d)}</p>
        <p><b>${same?fmt(s):`Del ${fmt(s)} al ${fmt(e)}`}</b> · ${esc(ev.time)} · ${esc(ev.place)}</p>
      </div>
      <div class="acts"><button class="btn ${joined?'ghost':''} small" data-join="${ev.id}" ${st.k==='past'?'disabled':''}>${joined?'Inscrito, cancelar':'Inscribirme'}</button></div>
    </div>`;
  }).join('');
}

