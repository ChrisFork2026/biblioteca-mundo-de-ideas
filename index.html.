 {t:'Rayuela',a:'Julio Cortázar',g:'Novela',y:1963,stock:1,views:54,waiting:1,d:'Una novela que se puede leer en más de un orden, siguiendo a Horacio Oliveira entre París y Buenos Aires.',rv:[]},
 {t:'Ficciones',a:'Jorge Luis Borges',g:'Cuento',y:1944,stock:2,views:61,d:'Cuentos sobre laberintos, bibliotecas, espejos y el infinito.',rv:[R('Prof. Linares',5,'Ideal para clases de análisis literario.')]},
 {t:'Veinte poemas de amor y una canción desesperada',a:'Pablo Neruda',g:'Poesía',y:1924,stock:4,views:88,d:'Poemario sobre el deseo, el amor y la despedida.',rv:[R('Valeria S.',4,'Hay poemas que releí muchas veces.')]},
