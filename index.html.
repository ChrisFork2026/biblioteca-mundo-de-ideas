    }).join('') : '<p class="note">Aún no has apartado libros. Busca uno en el catálogo y pulsa Reservar.</p>') +
    `<p class="note" style="margin-bottom:0">Te enviaremos un correo a ${esc(me.email)} un día antes de la fecha de devolución.</p>`;
  const evs = events.filter(e=>me.events.includes(e.id));
  $('#myEvents').innerHTML = `<h3 class="sub">Mis talleres y eventos</h3>` +
    (evs.length ? evs.map(ev=>`<div class="loan"><div><b>${esc(ev.t)}</b><div class="note">${fmt(parseD(ev.s))} · ${esc(ev.time)}</div></div></div>`).join('')
      : '<p class="note">Todavía no te has inscrito a ninguna actividad.</p>');
