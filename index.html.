    [...books].sort((a,b)=>a.id-b.id).map(b=>`<tr><td>${code(b)}</td><td>${esc(b.t)}</td><td>${esc(b.a)}</td><td>${b.y}</td>
      <td><span class="stock"><button data-stock="${b.id}" data-d="-1" aria-label="Quitar un ejemplar">−</button><b>${b.stock}</b><button data-stock="${b.id}" data-d="1" aria-label="Agregar un ejemplar">+</button></span></td>
      <td><button class="btn danger small" data-baja="${b.id}">Dar de baja</button></td></tr>`).join('') + '</tbody>';
  const all = users.flatMap(u=>u.loans.map(l=>({u,l})));
  $('#allLoans').innerHTML = all.length ? all.map(({u,l})=>`<div class="loan"><div><b>${esc(byId(l.id).t)}</b><div class="note">${esc(u.name)} (${esc(u.email)}) · devolver el ${fmt(l.due)}</div></div></div>`).join('')
