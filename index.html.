let openId = null;
function openBook(id, count=true){
  const b = byId(id); if(!b) return;
  if(count){ b.views++; renderTop(); renderShelf(); }
  openId = id;
  const c = colorOf(b);
  $('#bookBody').innerHTML = `
    <button class="close" data-close aria-label="Cerrar">&times;</button>
    <div style="display:grid;grid-template-columns:84px 1fr;gap:18px;margin-bottom:10px">
      <div class="cover" style="width:84px;height:116px;font-size:.85rem;background:${c.bg};color:${c.fg}" aria-hidden="true">${esc(b.t)}</div>
      <div>
        <h2 id="bkTitle" style="font-size:1.5rem">${esc(b.t)}</h2>
        <div class="meta">${esc(b.a)} · ${b.y}</div>
        <div class="tags"><span class="tag">${esc(b.g)}</span>${b.sv?'<span class="tag sv">Autor salvadoreño</span>':''}</div>
        <div style="margin-top:8px">${avail(b)}</div>
      </div>
    </div>
    <p>${esc(b.d)}</p>
    <p class="note">Código ${code(b)} · ISBN ${esc(b.isbn)}${b.publisher?` · Editorial ${esc(b.publisher)}`:''}</p>
    <div class="acts" style="justify-content:flex-start;margin:12px 0 18px">
      <button class="btn" data-reserve="${b.id}" ${b.stock<1?'disabled':''}>Reservar este libro</button>
    </div>
    <h3 class="sub" style="font-size:1.15rem">Opiniones ${b.rv.length?`<span class="stars">${starStr(avg(b))}</span> <span class="note">${avg(b).toFixed(1)} de 5 · ${b.rv.length}</span>`:''}</h3>
    ${b.rv.length ? b.rv.map(r=>`<div class="review"><b>${esc(r.name)}</b> <span class="stars">${starStr(r.stars)}</span><p>${esc(r.text)}</p></div>`).join('') : '<p class="note">Este libro todavía no tiene opiniones. Sé la primera persona en dejar una.</p>'}
    <form id="rvForm" style="margin-top:14px">
      <div class="fgrid">
        <div><label class="f" for="rvS">Tu calificación</label>
          <select id="rvS"><option value="5">5 · Excelente</option><option value="4">4 · Muy bueno</option><option value="3">3 · Bueno</option><option value="2">2 · Regular</option><option value="1">1 · No me gustó</option></select></div>
        <div class="full"><label class="f" for="rvT">Tu opinión</label><textarea id="rvT" rows="3" required placeholder="¿Qué te pareció?"></textarea></div>
        <div class="full"><button class="btn" type="submit">Publicar opinión</button></div>
      </div>
    </form>`;
  const dlg=$('#bookDlg'); if(!dlg.open) dlg.showModal();
}

/* ---------- Acciones ---------- */
function reserve(id){
  const b=byId(id);
  if(!me){ openAuth(); toast('Inicia sesión para reservar'); return; }
  if(me.role==='admin'){ toast('Los bibliotecarios gestionan las reservas desde su panel'); return; }
  if(me.loans.some(l=>l.id===id)){ toast('Ya tienes este libro reservado'); return; }
  if(me.loans.length>=3){ toast('Ya tienes 3 reservas. Cancela una para apartar otro libro'); return; }
  if(b.stock<1){ toast('Este libro no tiene ejemplares disponibles'); return; }
  b.stock--; me.loans.push({id,due:daysFrom(7)});
  toast(`Reservaste “${b.t}”. Devuélvelo antes del ${fmt(daysFrom(7))}`);
  renderAll(); if($('#bookDlg').open) openBook(id,false);
}
function renew(id){
  const b=byId(id), l=me.loans.find(x=>x.id===id);
  if(b.waiting>0){ toast('No se puede renovar: otra persona está esperando este libro'); return; }
  l.due=new Date(l.due.getTime()+7*DAY);
  toast(`Renovado hasta el ${fmt(l.due)}`); renderAccount(); renderAdmin();
}
function cancelLoan(id){
  me.loans=me.loans.filter(l=>l.id!==id); byId(id).stock++;
  toast('Reserva cancelada'); renderAll();
{ const P=new URLSearchParams(location.search);
  if(Q('#results') && (P.get('q')||P.get('genero'))){ $('#q').value=P.get('q')||''; $('#genre').value=P.get('genero')||''; renderCatalog(); } }
}
function joinEvent(id){
  if(!me){ openAuth(); toast('Inicia sesión para inscribirte'); return; }
  const i=me.events.indexOf(id);
  if(i>=0){ me.events.splice(i,1); toast('Inscripción cancelada'); }
  else { me.events.push(id); toast('Listo, quedaste inscrito'); }
  renderEvents(); renderAccount();
}
function searchFor(q,g=''){ $('#q').value=q; $('#genre').value=g; $('#onlyAvail').checked=false; renderCatalog(); if(location.hash==='#p-catalogo') scrollTo({top:0,behavior:smooth()}); else location.hash='#p-catalogo'; }

/* ---------- Sesión ---------- */
let mode='in';
function setMode(m){
  mode=m;
  $('#tabIn').setAttribute('aria-selected',m==='in'); $('#tabUp').setAttribute('aria-selected',m==='up');
  $('#nameWrap').classList.toggle('hide',m==='in'); $('#uName').required = m==='up';
  $('#authGo').textContent = m==='in'?'Iniciar sesión':'Crear cuenta';
  $('#uPass').autocomplete = m==='in'?'current-password':'new-password';
  $('#authErr').textContent='';
}
function openAuth(){ setMode('in'); const d=$('#authDlg'); if(!d.open) d.showModal(); }

$('#tabIn').onclick=()=>setMode('in');
$('#tabUp').onclick=()=>setMode('up');
$('#authForm').addEventListener('submit',e=>{
  e.preventDefault();
  const mail=$('#uMail').value.trim().toLowerCase(), pass=$('#uPass').value, err=$('#authErr');
  const found=users.find(u=>u.email===mail);
  if(mode==='in'){
    if(!found){ err.textContent='No existe una cuenta con ese correo. Usa “Crear cuenta” para registrarte.'; return; }
    if(found.pass!==pass){ err.textContent='La contraseña no es correcta. Revísala e inténtalo de nuevo.'; return; }
    me=found;
  } else {
    if(found){ err.textContent='Ese correo ya tiene una cuenta. Inicia sesión.'; return; }
    me={email:mail,name:$('#uName').value.trim(),pass,role:'lector',loans:[],events:[]}; users.push(me);
  }
  $('#authDlg').close(); $('#authForm').reset();
  toast(`Hola, ${me.name.split(' ')[0]}`); renderAll();
});

/* ---------- Eventos globales ---------- */
document.addEventListener('click',e=>{
  const t=e.target.closest('button,a'); if(!t) return;
  if(t.dataset.open) { openBook(+t.dataset.open); return; }
  if(t.dataset.reserve){ reserve(+t.dataset.reserve); return; }
  if(t.dataset.author){ if($('#bookDlg').open) $('#bookDlg').close(); searchFor(t.dataset.author); return; }
  if(t.dataset.genre){ searchFor('',t.dataset.genre); return; }
  if(t.dataset.login!==undefined){ openAuth(); return; }
  if(t.dataset.join){ joinEvent(+t.dataset.join); return; }
  if(t.dataset.renew){ renew(+t.dataset.renew); return; }
  if(t.dataset.cancel){ cancelLoan(+t.dataset.cancel); return; }
  if(t.dataset.close!==undefined){ t.closest('dialog').close(); return; }
  if(t.dataset.stock){ const b=byId(+t.dataset.stock); b.stock=Math.max(0,b.stock+ +t.dataset.d); renderAll(); return; }
  if(t.dataset.baja){
    const id=+t.dataset.baja;
    if(users.some(u=>u.loans.some(l=>l.id===id))){ toast('No se puede dar de baja: tiene reservas activas'); return; }
    const b=byId(id); books=books.filter(x=>x.id!==id); toast(`“${b.t}” se dio de baja`); renderAll(); return;
  }
  if(t.id==='btnLogin'){ openAuth(); return; }
  if(t.id==='btnOutSess'){ me=null; toast('Cerraste sesión'); renderAll(); return; }
});
document.querySelectorAll('dialog').forEach(d=>d.addEventListener('click',e=>{ if(e.target===d) d.close(); }));

$('#heroGo').onclick=()=>searchFor($('#heroQ').value);
$('#heroQ').addEventListener('keydown',e=>{ if(e.key==='Enter') searchFor($('#heroQ').value); });
$('#q').addEventListener('input',renderCatalog);
$('#genre').addEventListener('change',renderCatalog);
$('#onlyAvail').addEventListener('change',renderCatalog);

document.addEventListener('submit',e=>{
  if(e.target.id==='rvForm'){
    e.preventDefault();
    if(!me){ openAuth(); toast('Inicia sesión para dejar tu opinión'); return; }
    const b=byId(openId);
    b.rv.push({name:me.name,stars:+$('#rvS').value,text:$('#rvT').value.trim()});
    toast('Opinión publicada'); openBook(openId,false); renderAll();
  }
});

$('#addForm').addEventListener('submit',e=>{
  e.preventDefault();
  const id=Math.max(0,...books.map(b=>b.id))+1;
  books.push({id,t:$('#aT').value.trim(),a:$('#aA').value.trim(),publisher:$('#aE').value.trim(),y:+$('#aY').value,
    stock:+$('#aS').value,g:$('#aG').value.trim(),isbn:$('#aI').value.trim()||('978-99900-'+String(id).padStart(3,'0')+'-0'),
    views:0,waiting:0,d:'Recién agregado al catálogo.',rv:[],ingreso:today()});
  e.target.reset(); $('#aS').value=1;
  toast('Libro registrado. Ya aparece en Nuevos ingresos'); renderAll();
});

function movement(kind){
  const b=bookByCode($('#scan').value);
  if(!b){ toast('No encontramos ese código. Revisa e inténtalo de nuevo'); return; }
  if(kind==='out'){
    if(b.stock<1){ toast('No quedan ejemplares disponibles de ese libro'); return; }
    b.stock--; movements.unshift(`Salida: ${b.t} (${code(b)})`);
  } else { b.stock++; movements.unshift(`Devolución: ${b.t} (${code(b)})`); }
  $('#scan').value=''; $('#scan').focus(); toast(kind==='out'?'Salida registrada':'Devolución registrada'); renderAll();
}
$('#btnOut').onclick=()=>movement('out');
$('#btnIn').onclick=()=>movement('in');
$('#scan').addEventListener('keydown',e=>{ if(e.key==='Enter') movement('out'); });

renderAll();

/* ---------- Navegación entre secciones del sitio ---------- */
const TITLES={'inicio': 'Biblioteca Mundo de Ideas', 'catalogo': 'Catálogo', 'nuevos': 'Nuevos ingresos', 'populares': 'Lo más visto', 'eventos': 'Talleres y eventos', 'mis-reservas': 'Mis reservas', 'panel': 'Panel del bibliotecario'};
function route(){
  let k=(location.hash||'').replace('#p-',''); if(!TITLES[k]) k='inicio';
  document.querySelectorAll('.view').forEach(v=>v.classList.toggle('on',v.dataset.k===k));
  document.querySelectorAll('nav.main a').forEach(a=>a.getAttribute('href')==='#p-'+k?a.setAttribute('aria-current','page'):a.removeAttribute('aria-current'));
  document.title=(k==='inicio'?'':TITLES[k]+' · ')+'Biblioteca Mundo de Ideas'; scrollTo(0,0);
}
addEventListener('hashchange',route); route();
</script>
</body></html>
