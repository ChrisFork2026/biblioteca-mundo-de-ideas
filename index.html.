<script>
/* ---------- Utilidades ---------- */
const Q = s => document.querySelector(s);
/* En páginas donde un elemento no existe, $ devuelve un div suelto para que el código compartido no falle */
const $ = s => Q(s) || document.createElement('div');
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const norm = s => String(s).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
const DAY = 86400000;
const today = () => { const d = new Date(); d.setHours(0,0,0,0); return d; };
const daysFrom = n => new Date(today().getTime() + n*DAY);
const fmt = d => d.toLocaleDateString('es-SV',{day:'numeric',month:'long'});
const fmtShort = d => d.toLocaleDateString('es-SV',{month:'short'}).replace('.','');
const smooth = () => matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
const pad = n => String(n).padStart(4,'0');
const code = b => 'MI-' + pad(b.id);

/* ---------- Datos de ejemplo ---------- */
